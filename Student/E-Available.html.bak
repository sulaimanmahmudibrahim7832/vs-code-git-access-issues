<body>
  <h1>Exam schedule</h1>
  <div class="available-exam">
<div class="schedule-tample">
    <table border="1px">
      <thead>
        <tr>
          <th>
            Day
          </th>
          <th>
            Date
          </th>
          <th>
            Subjects
          </th>
          <th>
            Duration
          </th>
          <th>
            time
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            Friday
          </td>
          <td>
            01/08/2026
          </td>
          <td>
            physics <br>
            chemistry
          </td>
          <td>
            2 hours
          </td>
          <td>
            9:00am
          </td>
          
        </tr>
           <tr>
     <td>
       Monday
     </td>
     <td>
       02/08/2026
     </td>
     <td>
       Mathematics
     </td>
     <td>
       1 hour
     </td>
     <td>
       10:00am
     </td>
     
   </tr>
      <tr>
     <td>
       Thursday
     </td>
     <td>
       14/08/2026
     </td>
     <td>
       English 
     </td>
     <td>
       45 minutes
     </td>
     <td>
       8:15am
     </td>
     
   </tr>
      </tbody>
    </table>
    <button>print</button>
  </div>
</body>
</html>